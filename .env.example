# ============================================================================
# CryptoLand — Frontend Environment (.env)
# ============================================================================
# Copy to .env (local dev) or .env.production (build). NEVER commit real .env.
#
# CryptoLand ships as ONE codebase that deploys as N chain-native builds. Each
# deployment selects its target chain with VITE_CHAIN and fills in that chain's
# contract addresses. See env/ for ready-made per-chain templates.
# ----------------------------------------------------------------------------

# API origin. Empty = same-origin (dev uses the Vite proxy). For a deployed
# frontend talking to a separate API host, set the full URL, e.g.
#   VITE_API_BASE=https://api.cryptoland.example
VITE_API_BASE=

# Which chain THIS build targets. One of the CHAINS keys in
# src/lib/blockchain/config.js:
#   EVM:     polygon | avalanche | base | arbitrum | ronin | bnb | ethereum
#            (+ testnets: polygon-amoy, avalanche-fuji, base-sepolia,
#             arbitrum-sepolia, ronin-saigon, bnb-testnet)
#   Solana:  solana | solana-devnet
#   TON:     ton | ton-testnet
#   Aptos:   aptos | aptos-testnet
#   Sui:     sui | sui-testnet
VITE_CHAIN=polygon-amoy

# ── Contract addresses (fill in after you deploy each chain's contract) ──────
# Only the ones for VITE_CHAIN matter for a given build. Until set, purchases
# still work (DB-backed ownership); the on-chain NFT mint is skipped.

# EVM
VITE_CONTRACT_POLYGON=
VITE_CONTRACT_AVALANCHE=
VITE_CONTRACT_BASE=
VITE_CONTRACT_ARBITRUM=
VITE_CONTRACT_RONIN=
VITE_CONTRACT_BNB=
VITE_CONTRACT_ETHEREUM=

# Non-EVM
VITE_CONTRACT_SOLANA=
VITE_CONTRACT_TON=
VITE_CONTRACT_APTOS=
VITE_CONTRACT_SUI=

# Optional per-chain marketplace + token contract addresses (same naming:
# VITE_MARKETPLACE_<CHAIN>, VITE_TOKEN_<CHAIN>). Leave blank until deployed.
