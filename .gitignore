# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Dependencies / build output
node_modules
dist
dist-ssr
dist-*/
*.local

# ── Environment files with secrets ──────────────────────────────────────────
# Ignore all real env files. NOTE: `.env` (no basename) is NOT matched by
# `*.env`, so it must be listed explicitly.
.env
.env.*
server/.env
server/.env.*
# ...but DO commit the blank per-chain templates and the example.
!.env.example
!env/
!env/.env.*

# ── Databases (never commit — they hold live game + payment data) ────────────
*.db
*.db-journal
*.db-wal
*.sqlite
*.sqlite3

# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Per-chain deployment staging output (bundles + seeded DBs)
deploy/out/
