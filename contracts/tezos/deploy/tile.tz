{ parameter
    (or (pair %claim_tile (nat %tx) (nat %ty))
        (or (mutez %set_tile_price)
            (or (nat %set_market_fee_bps)
                (or (address %set_treasury_receiver)
                    (or (string %set_metadata_base)
                        (or (unit %withdraw)
                            (list %transfer
                               (pair (address %from_)
                                     (list %txs (pair (address %to_) (pair (nat %token_id) (nat %amount)))))))))))) ;
  storage
    (pair (address %administrator)
          (pair (big_map %ledger nat address)
                (pair (nat %total)
                      (pair (mutez %tile_price)
                            (pair (nat %market_fee_bps)
                                  (pair (mutez %treasury) (pair (address %treasury_receiver) (string %metadata_base)))))))) ;
  code { PUSH nat 16383 ;
         LAMBDA
           (pair address
                 (pair (big_map nat address)
                       (pair nat (pair mutez (pair nat (pair mutez (pair address string)))))))
           unit
           { CAR ;
             PUSH string "NOT_ADMIN" ;
             SWAP ;
             SENDER ;
             COMPARE ;
             EQ ;
             IF { DROP } { FAILWITH } ;
             UNIT } ;
         DIG 2 ;
         UNPAIR ;
         IF_LEFT
           { DIG 2 ;
             DROP ;
             PUSH mutez 0 ;
             DUP 3 ;
             GET 7 ;
             COMPARE ;
             GT ;
             IF {} { PUSH string "CLAIMING_DISABLED" ; FAILWITH } ;
             PUSH string "INSUFFICIENT_PAYMENT" ;
             DUP 3 ;
             GET 7 ;
             AMOUNT ;
             COMPARE ;
             GE ;
             IF { DROP } { FAILWITH } ;
             UNPAIR ;
             DUP 4 ;
             DUP 2 ;
             COMPARE ;
             LE ;
             IF {} { PUSH string "TX_OUT_OF_RANGE" ; FAILWITH } ;
             DIG 3 ;
             DUP 3 ;
             COMPARE ;
             LE ;
             IF {} { PUSH string "TY_OUT_OF_RANGE" ; FAILWITH } ;
             SWAP ;
             PUSH nat 32768 ;
             DIG 2 ;
             MUL ;
             ADD ;
             DUP 2 ;
             GET 3 ;
             DUP 2 ;
             GET ;
             IF_NONE {} { PUSH string "TILE_ALREADY_CLAIMED" ; FAILWITH } ;
             SENDER ;
             DUP 3 ;
             DUP 4 ;
             GET 3 ;
             DIG 2 ;
             SOME ;
             DIG 3 ;
             UPDATE ;
             UPDATE 3 ;
             PUSH nat 1 ;
             DUP 3 ;
             GET 5 ;
             ADD ;
             UPDATE 5 ;
             AMOUNT ;
             DIG 2 ;
             GET 11 ;
             ADD ;
             UPDATE 11 ;
             NIL operation }
           { DIG 3 ;
             DROP ;
             IF_LEFT
               { DUP 2 ; DIG 3 ; SWAP ; EXEC ; DROP ; UPDATE 7 ; NIL operation }
               { IF_LEFT
                   { DUP 2 ;
                     DIG 3 ;
                     SWAP ;
                     EXEC ;
                     DROP ;
                     PUSH nat 1000 ;
                     DUP 2 ;
                     COMPARE ;
                     LE ;
                     IF {} { PUSH string "FEE_ABOVE_CEILING" ; FAILWITH } ;
                     UPDATE 9 ;
                     NIL operation }
                   { IF_LEFT
                       { DUP 2 ; DIG 3 ; SWAP ; EXEC ; DROP ; UPDATE 13 ; NIL operation }
                       { IF_LEFT
                           { DUP 2 ; DIG 3 ; SWAP ; EXEC ; DROP ; UPDATE 14 ; NIL operation }
                           { IF_LEFT
                               { DROP ;
                                 DUP ;
                                 DIG 2 ;
                                 SWAP ;
                                 EXEC ;
                                 DROP ;
                                 PUSH mutez 0 ;
                                 DUP 2 ;
                                 GET 11 ;
                                 COMPARE ;
                                 GT ;
                                 IF {} { PUSH string "NOTHING_TO_WITHDRAW" ; FAILWITH } ;
                                 DUP ;
                                 GET 13 ;
                                 CONTRACT unit ;
                                 IF_NONE { PUSH string "BAD_RECEIVER" ; FAILWITH } {} ;
                                 DUP 2 ;
                                 GET 11 ;
                                 UNIT ;
                                 TRANSFER_TOKENS ;
                                 SWAP ;
                                 PUSH mutez 0 ;
                                 UPDATE 11 ;
                                 NIL operation ;
                                 DIG 2 ;
                                 CONS }
                               { DIG 2 ;
                                 DROP ;
                                 ITER { SWAP ;
                                        DUP 2 ;
                                        CDR ;
                                        ITER { SWAP ;
                                               DUP ;
                                               GET 3 ;
                                               DUP 3 ;
                                               GET 3 ;
                                               GET ;
                                               IF_NONE { PUSH string "FA2_TOKEN_UNDEFINED" ; FAILWITH } {} ;
                                               DUP 4 ;
                                               CAR ;
                                               COMPARE ;
                                               EQ ;
                                               IF {} { PUSH string "FA2_NOT_OWNER" ; FAILWITH } ;
                                               PUSH string "FA2_NOT_OPERATOR" ;
                                               DUP 4 ;
                                               CAR ;
                                               SENDER ;
                                               COMPARE ;
                                               EQ ;
                                               IF { DROP } { FAILWITH } ;
                                               PUSH nat 0 ;
                                               DUP 3 ;
                                               GET 4 ;
                                               COMPARE ;
                                               EQ ;
                                               IF { SWAP ; DROP }
                                                  { PUSH nat 1 ;
                                                    DUP 3 ;
                                                    GET 4 ;
                                                    COMPARE ;
                                                    EQ ;
                                                    IF {} { PUSH string "FA2_INSUFFICIENT_BALANCE" ; FAILWITH } ;
                                                    DUP ;
                                                    GET 3 ;
                                                    DUP 3 ;
                                                    CAR ;
                                                    SOME ;
                                                    DIG 3 ;
                                                    GET 3 ;
                                                    UPDATE ;
                                                    UPDATE 3 } } ;
                                        SWAP ;
                                        DROP } ;
                                 NIL operation } } } } } } ;
         PAIR } }

