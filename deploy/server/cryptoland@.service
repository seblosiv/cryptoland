# One backend per chain: systemctl enable --now cryptoland@algorand
#
# Templated so 27 chains share one unit file. Each instance gets its OWN SQLite
# database — this is not a preference. `blocks.tile_key` is a global PRIMARY KEY,
# so a single shared database would let the first chain to claim a tile lock it
# for all 27. Separate files make that structurally impossible.
[Unit]
Description=CryptoLand backend (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cryptoland
Group=cryptoland
WorkingDirectory=/srv/cryptoland/app/server
EnvironmentFile=/srv/cryptoland/%i/env
Environment=CRYPTOLAND_DB=/srv/cryptoland/%i/%i.db
Environment=HOST=127.0.0.1
ExecStart=/srv/cryptoland/venv/bin/python main.py
Restart=always
RestartSec=3

# Measured at 24 MB idle / 46 MB under load. 160 MB is ~3.5x the loaded figure:
# generous for a real traffic spike, tight enough that one runaway chain cannot
# take the other 26 down with it on a 4 GB box. Hitting MemoryMax kills only
# this instance, and Restart=always brings it straight back.
MemoryMax=160M
MemoryHigh=120M
# 2 vCPU shared across 27 services — no single chain may monopolise a core.
CPUWeight=100
CPUQuota=60%
TasksMax=64

# Hardening: the backend holds payment credentials and the full DB.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/cryptoland/%i
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
