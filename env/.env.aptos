# CryptoLand build config — Aptos — Ecosystem
# Usage: cp env/.env.aptos .env.production && npm run build
VITE_API_BASE=
VITE_CHAIN=aptos
VITE_CONTRACT_APTOS=
VITE_MARKETPLACE_APTOS=
VITE_TOKEN_APTOS=
# Scope every query to this build's chain. A no-op under one-DB-per-chain
# (all rows are this chain already); REQUIRED against a shared backend, where
# without it the map, stats and onboarding social proof show all chains at once.
VITE_SCOPE_TO_CHAIN=1
