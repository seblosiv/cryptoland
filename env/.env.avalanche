# CryptoLand build config — Avalanche — Retro9000
# Usage: cp env/.env.avalanche .env.production && npm run build
VITE_API_BASE=
VITE_CHAIN=avalanche
VITE_CONTRACT_AVALANCHE=0x89C6bcfb0aCC152F98599261dc2A72a996c3763F
VITE_MARKETPLACE_AVALANCHE=
VITE_TOKEN_AVALANCHE=
# Scope every query to this build's chain. A no-op under one-DB-per-chain
# (all rows are this chain already); REQUIRED against a shared backend, where
# without it the map, stats and onboarding social proof show all chains at once.
VITE_SCOPE_TO_CHAIN=1
