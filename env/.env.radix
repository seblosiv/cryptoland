# CryptoLand build config — Radix — Booster Grants (tiered)
# Usage: npm run build:chain radix   (emits dist-radix/)
VITE_API_BASE=
VITE_CHAIN=radix
VITE_CONTRACT_RADIX=
VITE_MARKETPLACE_RADIX=
VITE_TOKEN_RADIX=
# Optional: override the default public RPC with a paid endpoint (Alchemy etc.)
VITE_RPC_RADIX=
# Scope every query to this build's chain. A no-op under one-DB-per-chain
# (all rows are this chain already); REQUIRED against a shared backend, where
# without it the map, stats and onboarding social proof show all chains at once.
VITE_SCOPE_TO_CHAIN=1
